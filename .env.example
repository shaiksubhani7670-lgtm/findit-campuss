# FindIt Campus — Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# Flask
# ==========================================
SECRET_KEY=change-me-to-a-long-random-string
FLASK_ENV=development

# ==========================================
# JWT Authentication
# ==========================================
JWT_SECRET_KEY=change-me-to-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES=3600

# ==========================================
# Gmail Email Configuration
# ==========================================
# Step 1: Go to your Google Account → Security → 2-Step Verification → ON
# Step 2: Go to Security → App Passwords → Create a new App Password
# Step 3: Select "Mail" and copy the 16-character password below

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_DEFAULT_SENDER=FindIt Campus <your_gmail@gmail.com>
